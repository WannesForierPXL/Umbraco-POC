    <NodeName Default="Behandel modeloutput als onbetrouwbaar">
      <Name Culture="en-US">Treat model output as untrusted</Name>
      <Name Culture="nl-BE">Behandel modeloutput als onbetrouwbaar</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
    <Published Default="true">
      <Published Culture="en-US">true</Published>
      <Published Culture="nl-BE">true</Published>
    </Published>
    <Schedule />
    <Template />
  </Info>
  <Properties>
    <blokken>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "1b295723-9dcd-4d05-9d6f-f0c286b733aa",
      "key": "a27344be-d63a-4cd9-bc91-5aeeac3fe4cd",
      "values": [
        {
          "alias": "tekst",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EWhy?\u003C/h2\u003E\u003Cp\u003EAn LLM can be manipulated through \u003Cstrong\u003Eprompt injection\u003C/strong\u003E. What the model returns is therefore as untrusted as input from an unknown user.\u003C/p\u003E\u003Cul\u003E\u003Cli\u003ENever render output as raw HTML.\u003C/li\u003E\u003Cli\u003ENever execute generated code or queries without checks.\u003C/li\u003E\u003C/ul\u003E"
          }
        },
        {
          "alias": "tekst",
          "culture": "nl-BE",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EWaarom?\u003C/h2\u003E\u003Cp\u003EEen LLM kan via \u003Cstrong\u003Eprompt injection\u003C/strong\u003E gemanipuleerd worden. Wat het model teruggeeft, is dus net zo onbetrouwbaar als invoer van een onbekende gebruiker.\u003C/p\u003E\u003Cul\u003E\u003Cli\u003EToon output nooit als ruwe HTML.\u003C/li\u003E\u003Cli\u003EVoer gegenereerde code of queries nooit zonder controle uit.\u003C/li\u003E\u003C/ul\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "ecb55f3a-15b7-4728-b665-c7ae85ad88ac",
      "key": "8fd95982-a382-42b3-9808-f8e34dff91a4",
      "values": [
