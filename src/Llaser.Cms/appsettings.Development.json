{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      },
      "Global": {
        "InstallMissingDatabase": true,
        "Smtp": {
          "From": "noreply@llaser.test",
          "DeliveryMethod": "SpecifiedPickupDirectory",
          "PickupDirectoryLocation": "umbraco/Mail"
        }
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44310"
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Admin",
        "UnattendedUserEmail": "admin@llaser.test",
        "UnattendedTelemetryLevel": "Minimal"
      }
    }
  }
}
