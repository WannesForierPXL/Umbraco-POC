{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "70affc77-11c9-4c62-a8fc-bdbd0254143e"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": false,
        "RichTextOutputAsJson": false,
        "Media": {
          "Enabled": true,
          "PublicAccess": false
        }
      },
      "Webhook": {
        "Enabled": true,
        "PayloadType": "Minimal"
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportOnFirstBoot": true,
      "ExportOnSave": "All"
    },
    "Sets": {
      "Default": {
        "DisabledHandlers": [ "WebhookHandler" ]
      }
    }
  }
}
